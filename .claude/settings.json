{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm vitest:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run build)",
      "Bash(pnpm build)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(graphify update:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_extensions",
      "mcp__supabase__list_migrations",
      "mcp__supabase__get_advisors",
      "mcp__supabase__query_logs",
      "mcp__supabase__get_logs",
      "mcp__supabase__list_edge_functions",
      "mcp__supabase__get_edge_function",
      "mcp__supabase__search_docs",
      "mcp__supabase__generate_typescript_types"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./ss-pdo-*.json)",
      "Edit(./.env)",
      "Edit(./ss-pdo-*.json)",
      "Bash(cat .env:*)",
      "Bash(cat ss-pdo-*.json:*)"
    ]
  },
  "enabledMcpjsonServers": ["supabase"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-branch.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-raw-colors.mjs\"" }]
      }
    ]
  }
}
