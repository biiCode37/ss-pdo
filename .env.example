VITE_GAPI_CLIENT_ID=your_google_client_id
VITE_GAPI_API_KEY=your_google_api_key

# Supabase (PENTING — Mengontrol allowlist otorisasi & keamanan login user_profiles. Jika tidak diisi, verifikasi login akan ditolak / fail-closed — lihat BUG-37)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# (Opsional) URL Edge Function sinkron Sheets → Supabase. Jika kosong, otomatis memakai
# <VITE_SUPABASE_URL>/functions/v1/sheet-sync-webhook. Isi hanya bila webhook berada di proyek lain.
# VITE_SHEET_SYNC_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/sheet-sync-webhook
